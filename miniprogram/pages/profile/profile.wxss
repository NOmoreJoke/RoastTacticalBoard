.page {
  padding: 24rpx 24rpx 60rpx;
}

.tabs {
  padding: 10rpx;
  margin-bottom: 20rpx;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 12rpx;
  font-size: 27rpx;
  color: #b8b8d9;
}
.tab-on {
  background: #ffc93c;
  color: #1a1a2e;
  font-weight: 800;
}

.sec {
  padding: 28rpx;
}
.sec-title {
  font-size: 32rpx;
  margin-bottom: 20rpx;
}

/* 形象预览 */
.preview {
  margin-bottom: 20rpx;
}
.big-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 5rpx solid #f5f0e6;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 26rpx;
  flex-shrink: 0;
}
.big-emoji {
  font-size: 68rpx;
}
.big-number {
  position: absolute;
  right: -6rpx;
  bottom: -6rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #1a1a2e;
  border: 3rpx solid #f5f0e6;
  color: #fff;
  font-size: 26rpx;
  font-weight: 900;
  text-align: center;
  line-height: 44rpx;
}
.nick-input {
  background: #10102a;
  border: 2rpx solid #2e2e5e;
  border-radius: 12rpx;
  padding: 18rpx;
  font-size: 28rpx;
}

.grid-label {
  color: #8f8fb5;
  font-size: 24rpx;
  margin: 20rpx 0 10rpx;
}
.color-grid {
  display: flex;
  flex-wrap: wrap;
}
.color-dot {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin: 8rpx;
  border: 4rpx solid transparent;
}
.color-on {
  border-color: #f5f0e6;
  transform: scale(1.12);
}
.emoji-grid {
  display: flex;
  flex-wrap: wrap;
}
.emoji-cell {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  border-radius: 14rpx;
  margin: 6rpx;
  border: 3rpx solid transparent;
  background: #10102a;
}
.emoji-on {
  border-color: #ffc93c;
  background: rgba(255, 201, 60, 0.15);
}
.num-input {
  background: #10102a;
  border: 2rpx solid #2e2e5e;
  border-radius: 12rpx;
  padding: 16rpx;
  font-size: 30rpx;
  width: 200rpx;
  text-align: center;
}
.save-btn {
  margin-top: 28rpx;
}

/* 名单 */
.add-row {
  margin-bottom: 16rpx;
}
.name-input {
  background: #10102a;
  border: 2rpx solid #2e2e5e;
  border-radius: 12rpx;
  padding: 16rpx;
  font-size: 28rpx;
}
.add-btn {
  width: 96rpx;
  margin-left: 16rpx;
  padding: 16rpx 0;
}
.roster-item {
  padding: 16rpx 4rpx;
  border-bottom: 2rpx solid #2e2e5e;
}
.mini-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  flex-shrink: 0;
}
.roster-num {
  color: #8f8fb5;
  font-size: 22rpx;
}
.remove {
  color: #ff5a36;
  font-size: 24rpx;
}
.empty-hint {
  color: #8f8fb5;
  font-size: 24rpx;
  text-align: center;
  padding: 20rpx 0;
}

/* 标签 */
.chips {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 10rpx;
}
.chip-x {
  color: #ff5a36;
  font-weight: 900;
}
.err {
  color: #ff5a36;
  font-size: 24rpx;
  margin-bottom: 10rpx;
}
