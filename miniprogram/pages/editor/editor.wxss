.editor-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  padding: 16rpx 16rpx 0;
  box-sizing: border-box;
}

/* 顶栏 */
.topbar {
  margin-bottom: 12rpx;
}
.title-chip {
  max-width: 55%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  background: #1e1e3f;
  border: 3rpx solid #2e2e5e;
  border-radius: 12rpx;
  padding: 10rpx 20rpx;
  font-weight: 700;
  font-size: 26rpx;
}
.top-btn {
  background: #1e1e3f;
  border: 3rpx solid #2e2e5e;
  border-radius: 12rpx;
  padding: 10rpx 20rpx;
  font-size: 26rpx;
  font-weight: 700;
  margin-left: 12rpx;
}
.top-btn-hot {
  background: linear-gradient(135deg, #ff5a36, #ff9f1c);
  border-color: #1a1a2e;
  color: #fff;
}

/* 画布区 */
.board-wrap {
  justify-content: center;
}
.board-area {
  position: relative;
  border: 4rpx solid #2e2e5e;
  border-radius: 14rpx;
  overflow: hidden;
  background: #10102a;
}
.court-canvas {
  position: absolute;
  left: 0;
  top: 0;
}
.gesture-layer {
  position: absolute;
  inset: 0;
  z-index: 2;
}

/* 球员 token */
.token {
  position: absolute;
  width: 96rpx;
  height: 96rpx;
  margin-left: -48rpx;
  margin-top: -48rpx;
  border-radius: 50%;
  z-index: 3;
  display: flex;
  align-items: center;
  justify-content: center;
}
.token-emoji {
  font-size: 44rpx;
  line-height: 1;
}
.token-number {
  position: absolute;
  right: -4rpx;
  bottom: -4rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #1a1a2e;
  color: #fff;
  font-size: 20rpx;
  font-weight: 800;
  text-align: center;
  line-height: 36rpx;
  border: 2rpx solid #f5f0e6;
}
.token-name {
  position: absolute;
  top: 100rpx;
  left: 50%;
  transform: translateX(-50%);
  white-space: nowrap;
  font-size: 22rpx;
  font-weight: 800;
  color: #fff;
  text-shadow: 2rpx 2rpx 0 #1a1a2e, -2rpx 2rpx 0 #1a1a2e, 2rpx -2rpx 0 #1a1a2e, -2rpx -2rpx 0 #1a1a2e;
}

/* 吐槽气泡 */
.bubble {
  position: absolute;
  z-index: 4;
  transform: translate(-50%, -110%);
  max-width: 46%;
  background: #fffdf5;
  color: #1a1a2e;
  border: 4rpx solid #1a1a2e;
  border-radius: 16rpx;
  padding: 10rpx 16rpx;
  box-shadow: 6rpx 6rpx 0 rgba(0, 0, 0, 0.35);
}
.bubble::after {
  content: '';
  position: absolute;
  left: 30%;
  bottom: -20rpx;
  border: 10rpx solid transparent;
  border-top-color: #1a1a2e;
}
.bubble-text {
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.35;
  word-break: break-all;
}
.bubble-empty {
  color: #b08b5e;
  font-weight: 500;
}
.bubble-sub {
  margin-top: 4rpx;
  font-size: 18rpx;
}
.bubble-tags {
  color: #c2410c;
  font-weight: 700;
  margin-right: 10rpx;
}
.bubble-at {
  color: #1d4ed8;
  font-weight: 700;
}

/* 工具栏 */
.toolbar {
  margin-top: 14rpx;
  padding: 12rpx;
}
.tool-row {
  margin-bottom: 8rpx;
}
.tool-row:last-child {
  margin-bottom: 0;
}
.tool {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  margin: 0 6rpx;
  border-radius: 12rpx;
  background: #10102a;
  border: 2rpx solid #2e2e5e;
  font-size: 23rpx;
  color: #b8b8d9;
}
.tool-on {
  background: #ffc93c;
  color: #1a1a2e;
  font-weight: 800;
  border-color: #ffc93c;
}
.tool-add {
  background: rgba(255, 90, 54, 0.18);
  border-color: #ff5a36;
  color: #ff8a70;
}

/* 底部面板 */
.sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(10, 10, 26, 0.78);
  z-index: 50;
  display: flex;
  align-items: flex-end;
}
.sheet {
  width: 100%;
  box-sizing: border-box;
  border-radius: 24rpx 24rpx 0 0;
  background: #1e1e3f;
  padding: 30rpx 28rpx calc(30rpx + env(safe-area-inset-bottom));
  max-height: 80vh;
  overflow-y: auto;
}
.sheet-title {
  font-size: 34rpx;
  margin-bottom: 20rpx;
}
.sheet-label {
  font-size: 24rpx;
  color: #8f8fb5;
  margin: 20rpx 0 8rpx;
}
.sheet-btns {
  margin-top: 10rpx;
  flex-wrap: wrap;
}
.mini-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  flex-shrink: 0;
}
.sheet-name {
  font-size: 30rpx;
  font-weight: 800;
}
.mini-btn {
  background: #10102a;
  border: 2rpx solid #2e2e5e;
  border-radius: 10rpx;
  padding: 8rpx 16rpx;
  font-size: 22rpx;
  margin: 6rpx 10rpx 0 0;
  color: #b8b8d9;
}
.chips {
  display: flex;
  flex-wrap: wrap;
}
.sheet-foot {
  margin-top: 26rpx;
}
.sheet-gap {
  width: 20rpx;
}

/* 吐槽输入 */
.roast-input {
  width: 100%;
  box-sizing: border-box;
  height: 140rpx;
  background: #10102a;
  border: 2rpx solid #2e2e5e;
  border-radius: 12rpx;
  padding: 16rpx;
  font-size: 26rpx;
  color: #f5f0e6;
}

/* 添加球员 */
.tabs {
  margin-bottom: 16rpx;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 12rpx;
  background: #10102a;
  border: 2rpx solid #2e2e5e;
  font-size: 26rpx;
  margin-right: 10rpx;
  color: #b8b8d9;
}
.tab:last-child {
  margin-right: 0;
}
.tab-on {
  background: #ffc93c;
  color: #1a1a2e;
  font-weight: 800;
}
.roster-item {
  padding: 16rpx 8rpx;
  border-bottom: 2rpx solid #2e2e5e;
}
.roster-add {
  color: #ffc93c;
  font-weight: 800;
}
.name-input {
  background: #10102a;
  border: 2rpx solid #2e2e5e;
  border-radius: 12rpx;
  padding: 16rpx;
  font-size: 28rpx;
  margin-bottom: 16rpx;
}
.empty-hint {
  color: #8f8fb5;
  font-size: 24rpx;
  text-align: center;
  padding: 20rpx 0;
}

/* 导出 */
.poster {
  width: 100%;
  border-radius: 12rpx;
  border: 3rpx solid #2e2e5e;
}
.share-btn {
  line-height: 1.4;
  font-size: 28rpx;
}
.share-btn::after {
  border: none;
}
.export-canvas {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 375px;
  height: 500px;
}
